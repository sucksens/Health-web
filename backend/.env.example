# === Base de datos ===
# Opcion 1: SQLite (recomendado para desarrollo local)
DATABASE_URL=sqlite:///./health.db
# Opcion 2: MySQL (produccion)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/health_db

# === JWT ===
JWT_SECRET_KEY=<genera-uno-con:-python -c "import secrets; print(secrets.token_urlsafe(64))">
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === CORS ===
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
