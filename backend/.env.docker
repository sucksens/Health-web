# === Base de datos (MySQL en Docker) ===
DATABASE_URL=mysql+pymysql://health_user:health_pass@mysql:3306/health_db

# === JWT ===
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === CORS ===
# Reemplaza "https://salud.tudominio.com" con tu dominio real en NPM
CORS_ORIGINS=["http://localhost:3000","https://salud.tudominio.com"]

# === MySQL ===
MYSQL_ROOT_PASSWORD=health_root_pw
MYSQL_DATABASE=health_db
MYSQL_USER=health_user
MYSQL_PASSWORD=health_pass
